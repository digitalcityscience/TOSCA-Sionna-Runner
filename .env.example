# TOSCA-Sionna Runner settings. Copy to .env and start with
#   uv run --env-file .env uvicorn app:app --host 127.0.0.1 --port 8770

# Web origins allowed to call the runner (the TOSCA site), comma-separated.
SIONNA_RUNNER_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Sionna CityJSON endpoint used when the TOSCA site sends none
# (metadata.json and tiles/<name>.city.jsonl):
SIONNA_TILE_SOURCE="http://x.x.x.x:8081/catalog/lod3_cityjsonseq_hamburg"

# Optional:
# SIONNA_TILE_CACHE="C:/Users/me/.cache/tosca-sionna-runner/tiles"
# SIONNA_DATA_DIR="data"            # extra CityJSON tiles and Mitsuba scenes
# SIONNA_WORK_DIR=""                # default: the system temp folder
# SIONNA_RUNNER_TOKEN=""            # the web panel sends none; leave unset for it
